# /etc/teslatv/teslatv.env  (mode 0640 root:teslatv) - copy from teslatv.env.example
# TV_SECRET is generated by deploy/lxc/install.sh (signs the short-lived stream tickets).
TV_SECRET=__generated_by_install_sh__

# ---- Hostnames ----
# UI + control channel: behind Cloudflare Access (cloudflared tunnel -> 127.0.0.1:TV_PORT)
TV_PUBLIC_HOST=tv.example.com
# Video/audio: direct path (VPS + WireGuard -> Caddy -> 127.0.0.1:TV_STREAM_PORT), ticket-gated
TV_STREAM_HOST=tv-stream.example.com

# ---- Cloudflare Access (Zero Trust -> Access -> Applications -> your app) ----
TV_ACCESS_TEAM=yourteam.cloudflareaccess.com
TV_ACCESS_AUD=__application_audience_tag__
TV_TICKET_TTL_S=43200

# ---- Listeners (localhost only) ----
TV_LISTEN=127.0.0.1
TV_PORT=8090
TV_STREAM_PORT=8091

# ---- v1 kiosk (sign-in remote browser) ----
# Virtual screen. 16:10 matches the Tesla centre screen closely. ----
TV_DISPLAY=:99
TV_SCREEN_W=1920
TV_SCREEN_H=1200
# Chrome UI zoom (1.25 = bigger tap targets on the car screen)
TV_SCALE=1.25

# Browser
# off = software compositor (default, best without a GPU) | swiftshader = emulated GL
TV_GPU_MODE=off
TV_HOME_URL=https://www.youtube.com/
TV_CDP_PORT=9222
TV_PROFILE=/var/lib/teslatv/chrome-profile
# Comma-separated unpacked extension directories, e.g. uBlock Origin Lite
TV_EXTENSIONS=/var/lib/teslatv/extensions/ublock-lite

# ---- v2 player: YouTube data + media cache ----
# yt-dlp binary (install it yourself; deploy/lxc/install.sh does not). Keep it up to date.
#TV_YTDLP=yt-dlp
# State directory: cookies.txt (exported YouTube cookies) and media/ (chunk cache) live here.
# Must stay inside ReadWritePaths of teslatv-web.service.
#TV_STATE_DIR=/var/lib/teslatv
# Media chunk cache size limit in GB (LRU-pruned every 30 min). Default 6.
#TV_CACHE_GB=6
# Outbound connections to googlevideo: DNS result order (ipv4first | verbatim) and the
# per-address connect attempt timeout in ms (Node's default of 250 ms is too short for some edges).
#TV_DNS_ORDER=ipv4first
#TV_CONNECT_ATTEMPT_MS=2000
# Set to 1 to log upstream media timings (debugging only).
#TV_MEDIA_DEBUG=

# ---- v1 sign-in stream: low | med | high  (see server/src/stream.js PRESETS) ----
# Only used while /signin is open.
TV_PRESET=med
TV_IDLE_STOP_MS=30000
TV_PULSE_SERVER=unix:/run/teslatv/pulse/native
TV_PULSE_SOURCE=tv.monitor
#TV_FFMPEG=ffmpeg
TV_PROBE_DIR=/var/lib/teslatv/probe
