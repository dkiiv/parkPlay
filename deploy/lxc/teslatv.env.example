# /etc/teslatv/teslatv.env  (mode 0640 root:teslatv) - copy from teslatv.env.example
# Secrets: generate with  deploy/lxc/install.sh  (it fills TV_SECRET and asks for the password)

TV_SECRET=__generate_with_openssl_rand_hex_32__
TV_PASSWORD_HASH=__node_src_auth.js_hash__

# Web server (Caddy terminates TLS and proxies here)
TV_LISTEN=127.0.0.1
TV_PORT=8090
TV_SECURE_COOKIE=1

# Virtual screen. 16:10 matches the Tesla centre screen closely.
TV_DISPLAY=:99
TV_SCREEN_W=1920
TV_SCREEN_H=1200
# Chrome UI zoom (1.25 = bigger tap targets on the car screen)
TV_SCALE=1.25

# Browser
TV_HOME_URL=https://www.youtube.com/
TV_CDP_PORT=9222
TV_PROFILE=/var/lib/teslatv/chrome-profile
# Comma-separated unpacked extension directories, e.g. uBlock Origin Lite
TV_EXTENSIONS=/var/lib/teslatv/extensions/ublock-lite

# Stream: low | med | high  (see server/src/stream.js PRESETS)
TV_PRESET=med
TV_IDLE_STOP_MS=30000
TV_PULSE_SERVER=unix:/run/teslatv/pulse/native
TV_PULSE_SOURCE=tv.monitor
TV_PROBE_DIR=/var/lib/teslatv/probe
