# /etc/caddy/Caddyfile on the TeslaTV host.
# Serves ONLY the stream hostname. The VPS forwards TCP 80/443 here over WireGuard, so TLS
# terminates on this host (Let's Encrypt) and the VPS only sees ciphertext.
# The UI hostname is NOT served here: it goes through cloudflared + Cloudflare Access.
# /media/* (v2 player media) must stay in @media, or every video 404s in the car.
# /ws/video and /audio.mp3 are the v1 sign-in view.
{
	email {$TV_ACME_EMAIL}
}

{$TV_STREAM_HOST} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	@media path /ws/video /audio.mp3 /healthz /media/*
	handle @media {
		reverse_proxy 127.0.0.1:8091 {
			flush_interval -1
		}
	}
	handle {
		respond 404
	}
	log {
		output file /var/log/caddy/teslatv.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
