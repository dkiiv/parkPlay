[Unit]
Description=TeslaTV web server (UI/API, media proxy, sign-in stream)
After=teslatv-session.service
Wants=teslatv-session.service

[Service]
User=teslatv
Group=teslatv
EnvironmentFile=/etc/teslatv/teslatv.env
WorkingDirectory=/opt/teslatv/server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/teslatv
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
