[Unit]
Description=ParkPlay kiosk session (Xvfb + PulseAudio + Chrome, used for sign-in)
After=network-online.target
Wants=network-online.target

[Service]
User=parkplay
Group=parkplay
EnvironmentFile=/etc/parkplay/parkplay.env
RuntimeDirectory=parkplay
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/opt/parkplay/deploy/lxc/session.sh
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
Nice=-2

[Install]
WantedBy=multi-user.target
